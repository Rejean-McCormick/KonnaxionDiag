  "taxonomy": {
    "Nxx": "functional qualification campaigns",
    "Sxx": "security qualification campaigns",
    "SEC-xx": "architectural security invariants",
    "evidence": "facts/attestations that support an invariant",
    "PEP": "component that actually forbids the protected transition"
