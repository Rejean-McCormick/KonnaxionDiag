{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "konnaxiondiag.risk-acceptance.v1",
  "type": "object",
  "required": ["schema", "status", "rationale", "requested_by", "approved_by", "approval_id", "approved_at", "expires_at", "policy_version", "scope", "signature"],
  "properties": {
    "schema": {"const": "konnaxiondiag.risk-acceptance.v1"},
    "status": {"enum": ["accepted", "approved", "risk-accepted"]},
    "rationale": {"type": "string", "minLength": 1},
    "requested_by": {"type": "string", "minLength": 1},
    "approved_by": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "approval_id": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "policy_version": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["release_set_digest", "finding_fingerprint"],
      "properties": {
        "release_set_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "finding_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "signature": {"type": "object"}
  },
  "additionalProperties": true
}
