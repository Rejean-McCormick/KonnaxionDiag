{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "konnaxiondiag.security-contract-attestation.v1",
  "type": "object",
  "required": ["schema", "contract_id", "status", "issuer", "issued_at", "subject", "evidence_sha256"],
  "properties": {
    "schema": {"const": "konnaxiondiag.security-contract-attestation.v1"},
    "contract_id": {"pattern": "^SEC-[0-9]{2}$"},
    "status": {"const": "PASS"},
    "issuer": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string"},
    "subject": {
      "type": "object",
      "required": ["release_subject_sha256"],
      "properties": {
        "release_subject_sha256": {"pattern": "^[0-9a-fA-F]{64}$"}
      },
      "additionalProperties": true
    },
    "evidence_sha256": {"pattern": "^[0-9a-fA-F]{64}$"}
  },
  "additionalProperties": true
}
